# LINE Notify 設定 (本命マークアイドルの自動新着プッシュ通知用: 完全無料・無制限)
LINE_NOTIFY_TOKEN=your_line_notify_token_here

# LINE Messaging API 設定 (対話応答用Webhook)
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# ローカルWebサーバーポート
PORT=5000

# 機能制御 (True / False)
ENABLE_X_SCRAPING=True
ENABLE_TIGET_SCRAPING=True
ENABLE_LIVEPOCKET_SCRAPING=True

# X (Twitter) 用公開Nitter RSSミラーサイト
NITTER_BASE_URL=https://nitter.poast.org
